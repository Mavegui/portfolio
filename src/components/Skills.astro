---
interface SkillCategory {
  category: string;
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    category: 'Backend & Banco de Dados',
    skills: ['Python', 'Django', 'Java', 'Node.js', 'APIs RESTful', 'PostgreSQL', 'MySQL', 'MongoDB']
  },
  {
    category: 'Frontend & UI',
    skills: ['Astro', 'React', 'TypeScript', 'JavaScript', 'Tailwind CSS', 'HTML5 / CSS3']
  },
  {
    category: 'DevOps & Ferramentas',
    skills: ['Git / GitHub', 'Docker', 'Linux', 'GCP (Google Cloud)', 'AWS', 'Supabase', 'Vercel / Render']
  },
  {
    category: 'Práticas & Arquitetura',
    skills: ['Clean Code', 'Testes Automatizados', 'Arquitetura REST', 'Acessibilidade (a11y)', 'Lighthouse 100/100']
  }
];
---

<section id="habilidades" class="py-20 font-mono border-b-2 border-zinc-800">
  <div class="max-w-screen-xl mx-auto px-4">

    <div class="text-center max-w-xl mx-auto mb-12 space-y-2">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-red-400">Competências</h2>
      <p class="text-3xl font-bold text-white tracking-tight">Habilidades Técnicas</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCategories.map((group) => (
        <div class="p-6 bg-zinc-950 border-2 border-zinc-800 rounded-none space-y-4 hover:border-zinc-700 transition-colors duration-200">

          <div class="flex items-center gap-2 border-b border-zinc-800 pb-3">
            <span class="text-red-500 font-bold">&gt;</span>
            <h3 class="text-base font-bold text-white uppercase tracking-wider">{group.category}</h3>
          </div>

          <div class="flex flex-wrap gap-2 pt-1">
            {group.skills.map((skill) => (
              <span class="px-3 py-1.5 text-xs font-medium text-zinc-300 bg-zinc-900 border border-zinc-800 rounded-none hover:border-red-500 hover:text-white transition-colors duration-200">
                {skill}
              </span>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
---
interface Props {
  size?: number;
  opacityClass?: string;
}

const {
  opacityClass = "bg-[linear-gradient(to_right,#1f293733_1px,transparent_1px),linear-gradient(to_bottom,#1f293733_1px,transparent_1px)]"
} = Astro.props;
---

<div
  class={`absolute inset-0 ${opacityClass} bg-[size:24px_24px] pointer-events-none`}
  aria-hidden="true"
></div>
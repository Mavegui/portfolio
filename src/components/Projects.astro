---
import GridPattern from './GridPattern.astro';

interface Project {
  title: string;
  description: string;
  tags: string[];
  githubUrl?: string;
  liveUrl?: string;
}

const projects: Project[] = [
  {
    title: 'Portfólio Pessoal',
    description: 'Portfólio de alta performance desenvolvido com Astro e Tailwind CSS, focado no padrão Lighthouse 100/100.',
    tags: ['Astro', 'Tailwind CSS', 'TypeScript'],
    githubUrl: 'https://github.com/Mavegui/portfolio',
    liveUrl: 'https://mavegui.github.io/portfolio/'
  },
  {
    title: 'Acervo Milagres',
    description: 'Plataforma web de extensão universitária para catalogação e preservação digital da memória histórica e cultural de Milagres.',
    tags: ['Django', 'Python', 'PostgreSQL', 'Tailwind CSS'],
    githubUrl: 'https://github.com/Mavegui/acervo_Milagres',
    liveUrl: 'https://acervo-milagres.onrender.com/'
  },
  {
    title: 'Otimizador de Currículo ATS',
    description: 'Aplicação que utiliza Inteligência Artificial para analisar e otimizar currículos de acordo com a descrição de vagas de emprego.',
    tags: ['IA / LLM', 'Full Stack', 'Python', 'React'],
    githubUrl: 'https://github.com/Mavegui/otimizador_ATS',
  }
];
---

<section id="projetos" class="relative overflow-hidden py-20 font-mono border-b-2 border-zinc-800">
  <GridPattern />
  <div class="max-w-screen-xl mx-auto px-4 relative">

    <div class="text-center max-w-xl mx-auto mb-12 space-y-2">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-red-400">Portfólio</h2>
      <p class="text-3xl font-bold text-white tracking-tight">Projetos em Destaque</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <div class="flex flex-col justify-between p-6 bg-zinc-950 border-2 border-zinc-800 rounded-none hover:border-zinc-700 transition-colors duration-200 group">

          <div class="space-y-4">
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-0.5 text-xs font-medium text-red-400 bg-red-500/10 border border-red-500/20 rounded-none">
                  {tag}
                </span>
              ))}
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-red-400 transition-colors">
              {project.title}
            </h3>
            <p class="text-sm text-gray-400 leading-relaxed font-sans">
              {project.description}
            </p>
          </div>

          <div class="flex items-center space-x-4 pt-6 mt-6 border-t border-zinc-800">
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center space-x-1.5 text-xs font-semibold text-gray-300 hover:text-white transition-colors"
              >
                <span>Código Fonte</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center space-x-1.5 text-xs font-semibold text-red-400 hover:text-red-300 transition-colors"
              >
                <span>Ver Demonstração</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>

        </div>
      ))}

      <div class="flex flex-col justify-between p-6 bg-zinc-950 border-2 border-dashed border-zinc-800 rounded-none hover:border-red-500/80 transition-colors duration-200 group">
        <div class="space-y-4">
          <span class="inline-block px-2.5 py-0.5 text-xs font-medium text-zinc-400 bg-zinc-900 border border-zinc-800">
            Repositórios
          </span>
          <h3 class="text-xl font-bold text-white group-hover:text-red-400 transition-colors">
            Ver Mais no GitHub
          </h3>
          <p class="text-sm text-gray-400 leading-relaxed font-sans">
            Explore outros repositórios, utilitários, estudos de caso e contribuições em código aberto.
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-zinc-800">
          <a
            href="https://github.com/Mavegui?tab=repositories"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-2 text-xs font-bold text-red-500 hover:text-red-400 uppercase tracking-wider transition-colors"
          >
            <span>Acessar Perfil Completo</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
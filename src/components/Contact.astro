---
import GridPattern from './GridPattern.astro';
---

<section id="contato" class="py-20 font-mono relative overflow-hidden">
  <GridPattern />
  <div class="max-w-screen-xl mx-auto px-4 relative">

    <div class="max-w-2xl mx-auto bg-zinc-950 border-2 border-zinc-800 p-8 sm:p-10 rounded-none space-y-8">

      <div class="text-center space-y-2">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-red-400">Contato</h2>
        <p class="text-3xl font-bold text-white tracking-tight">Vamos Conversar?</p>
        <p class="text-sm text-gray-400 font-sans">Preencha o formulário abaixo ou envie uma mensagem direta.</p>
      </div>

      <form action="https://formspree.io/f/xwlebgko" method="POST" class="space-y-4">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" />

        <div>
          <label for="name" class="block text-xs font-medium text-gray-300 mb-1">Nome</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Seu nome"
            class="w-full px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-none text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 transition-colors"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-medium text-gray-300 mb-1">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="seu@email.com"
            class="w-full px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-none text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 transition-colors"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-medium text-gray-300 mb-1">Mensagem</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Como posso ajudar no seu projeto?"
            class="w-full px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-none text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 transition-colors resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-6 font-semibold text-sm text-white bg-red-600 hover:bg-red-500 active:bg-red-700 border-2 border-red-600 hover:border-red-500 rounded-none transition-colors duration-200 text-center outline-none focus-visible:ring-2 focus-visible:ring-red-400 uppercase tracking-wider"
        >
          Enviar Mensagem
        </button>
      </form>

    </div>

  </div>
</section>
---
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/Mavegui',
    icon: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z'
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/gui77feitosa/',
    icon: 'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.239-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z'
  }
];
---

<footer class="w-full bg-zinc-950 border-t-2 border-zinc-800 text-gray-300 relative z-10 font-mono">
  <div class="max-w-screen-xl mx-auto px-4 pt-10 pb-6">

    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pb-8 border-b border-zinc-800 text-center sm:text-left">

      <div class="space-y-1">
        <h3 class="text-xl font-bold text-white tracking-tight">
          Vamos construir algo incrível juntos<span class="text-red-500">?</span>
        </h3>
        <p class="text-xs text-zinc-400 font-sans">
          Estou disponível para novos projetos, colaborações e oportunidades.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
        <a
          href="#contato"
          class="inline-flex items-center justify-center px-4 py-2.5 text-xs font-semibold text-white bg-red-600 hover:bg-red-500 active:bg-red-700 border-2 border-red-600 hover:border-red-500 rounded-none transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-red-400 outline-none uppercase tracking-wider"
        >
          Iniciar conversa
        </a>

        <div class="flex items-center space-x-2">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="p-2.5 bg-zinc-950 text-zinc-400 hover:text-white hover:bg-zinc-900 border-2 border-zinc-800 hover:border-zinc-700 rounded-none transition-colors duration-200 outline-none focus-visible:ring-2 focus-visible:ring-red-400"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

    </div>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 gap-2">
      <div class="flex items-center space-x-2">
        <span class="font-bold text-white tracking-wider uppercase">MAVEGUI<span class="text-red-500">_</span></span>
        <span>— © {currentYear} Guilherme.</span>
      </div>
      <p class="text-zinc-500">Desenvolvido com Astro & Tailwind CSS</p>
    </div>

  </div>
</footer>